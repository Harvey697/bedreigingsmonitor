{
  "framework": "vite",
  "installCommand": "npm install --include=dev",
  "buildCommand": "if [ ! -x node_modules/.bin/vite ]; then npm install --include=dev; fi && ./node_modules/.bin/vite build",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
